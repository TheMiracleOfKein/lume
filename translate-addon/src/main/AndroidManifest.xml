<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for downloading language packs from Mozilla's model storage, when Lume asks. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No launcher icon: the add-on is used from Lume's text reader. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">
        <service
            android:name=".TranslateService"
            android:exported="true"
            android:permission="com.lume.permission.TRANSLATE">
            <intent-filter>
                <action android:name="com.lume.translate.BIND" />
            </intent-filter>
        </service>
    </application>
</manifest>
