diff --git a/cmake/FindPCRE2.cmake b/cmake/FindPCRE2.cmake
index 8ea55cb..2226af0 100644
--- a/cmake/FindPCRE2.cmake
+++ b/cmake/FindPCRE2.cmake
@@ -14,6 +14,11 @@ if(SSPLIT_USE_INTERNAL_PCRE2)
   set(PCRE2_FILENAME "pcre2-${PCRE2_VERSION}")
   set(PCRE2_TARBALL "${PCRE2_FILENAME}.tar.gz")
   set(PCRE2_SRC_DIR ${CMAKE_CURRENT_SOURCE_DIR}/src/3rd-party/${PCRE2_FILENAME})
+  if(ANDROID)
+    # One copy per ABI build: Gradle builds the ABIs in parallel, and a shared folder in the
+    # source tree made them download and unpack over each other.
+    set(PCRE2_SRC_DIR ${CMAKE_BINARY_DIR}/${PCRE2_FILENAME})
+  endif()
 
   # Download tarball only if we don't have the pcre2 source code yet.
   # For the time being, we download and unpack pcre2 into
@@ -27,6 +32,11 @@ if(SSPLIT_USE_INTERNAL_PCRE2)
       set(PCRE2_URL "https://github.com/PhilipHazel/pcre2/releases/download/${PCRE2_FILENAME}/${PCRE2_TARBALL}")
     message("Downloading pcre2 source code from ${PCRE2_URL}")
   endif()
+  set(PCRE2_HASH_ARG "")
+  if(PCRE2_URL)
+    # The 10.39 release tarball; a changed or cut-off download fails the build.
+    set(PCRE2_HASH_ARG URL_HASH SHA256=0781bd2536ef5279b1943471fdcdbd9961a2845e1d2c9ad849b9bd98ba1a9bd4)
+  endif()
 
   # Set configure options for internal pcre2 depeding on compiler
   if(CMAKE_CXX_COMPILER MATCHES "/em\\+\\+(-[a-zA-Z0-9.])?$")
@@ -60,6 +70,9 @@ if(SSPLIT_USE_INTERNAL_PCRE2)
     LIST(APPEND PCRE2_CONFIGURE_OPTIONS 
       -DANDROID_PLATFORM=${ANDROID_PLATFORM} 
       -DANDROID_ABI=${ANDROID_ABI}
+      # Same generator as the parent build: on a Windows host the default would be NMake.
+      -G ${CMAKE_GENERATOR}
+      -DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}
     )
   endif(ANDROID)
 
@@ -73,6 +86,7 @@ if(SSPLIT_USE_INTERNAL_PCRE2)
   ExternalProject_Add(pcre2
     PREFIX ${CMAKE_BINARY_DIR}/pcre2
     URL ${PCRE2_URL}
+    ${PCRE2_HASH_ARG}
     DOWNLOAD_DIR ${PCRE2_SRC_DIR}
     SOURCE_DIR ${PCRE2_SRC_DIR}
     CONFIGURE_COMMAND ${CMAKE_COMMAND} ${PCRE2_SRC_DIR} ${PCRE2_CONFIGURE_OPTIONS}
