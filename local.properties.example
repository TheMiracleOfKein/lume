## Copy to local.properties (gitignored) and fill in values.
## Android Studio usually writes sdk.dir automatically.

sdk.dir=C\:\\Path\\To\\Android\\sdk

# OAuth application credentials (identify Lume as a client on the tracker).
# End users log in with their own accounts; they never enter these values.
# Leave empty if you do not need tracker login in your build.
LUME_ANILIST_CLIENT_ID=
LUME_ANILIST_CLIENT_SECRET=
LUME_SHIKIMORI_CLIENT_ID=
LUME_SHIKIMORI_CLIENT_SECRET=
# MyAnimeList: create an API client at https://myanimelist.net/apiconfig with the
# redirect URL lume://oauth/myanimelist. Only the client ID is needed.
LUME_MAL_CLIENT_ID=
